# Copy to .env and adjust. No secrets are required by this application.
APP_ENV=development            # development | production | test
DATABASE_URL=sqlite:///database/fraudshield.db
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BYTES=1000000
REPORTS_DIR=reports
BACKUPS_DIR=backups
# Serve the built frontend (frontend/dist) from the API process (used by `run.bat prod` and Docker)
SERVE_FRONTEND=true
# Seed synthetic demonstration data on first start when the database is empty
AUTO_SEED_DEMO=false
